# Example settings for the backend.

# WHAT IS A .env FILE: a plain text file that holds settings for the app, one per line, written as NAME=value. 
# The code reads these settings when it starts (see src/config.js), instead of having them written directly inside the code. 
# This way each person can use different settings on their own computer without changing any code.

# HOW TO USE: copy this file and name the copy ".env" (same folder). Then change the values in your .env if needed.

# WHY TWO FILES: .env holds each person's real settings and is never uploaded to GitHub (see .gitignore), because later it 
# may contain passwords. This example file IS uploaded, so the team knows which settings exist.

# PORT: the "door number" on your computer where the server
# listens for requests. You open the backend in the browser at http://localhost:PORT
# We use 3000 because it is the usual port for Node/Express projects. Any free number above 1024 works. 
# If 3000 is already used by another program on your machine, change it in your .env (for example to 4000) and nobody else is affected.
PORT=3000

# DB_FILE: the name of the SQLite database file. 
# SQLite keeps the whole database in this one file inside the backend folder.
# It is created automatically the first time the server runs.
# Each person has their own copy with their own test data, so it is not uploaded to GitHub (*.db in .gitignore).
DB_FILE=fitness.db